package com.brunocorrea.conta

class BankAccount(
    private val owner: String,
    balance: Double = 0.0
) {
    var balance: Double = balance
        private set

    fun deposit(amount: Double) {
        require(amount > 0) { "Valor do depósito deve ser positivo." }
        balance += amount
    }

    fun withdraw(amount: Double) {
        require(amount > 0) { "Valor do saque deve ser positivo." }
        require(amount <= balance) { "Saldo insuficiente." }
        balance -= amount
    }

    fun getOwner(): String = owner
}
